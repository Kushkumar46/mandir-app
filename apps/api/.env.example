# Copy to .env for local development. Values match docker-compose.yml.
NODE_ENV=development
APP_ENV=local
PORT=4000

DATABASE_URL=postgresql://mandir:mandir@localhost:5432/mandir?schema=public
REDIS_URL=redis://localhost:6379

# DEV_AUTH stub: header `X-Dev-User: dev-user | dev-admin | <userId>`. Refused when NODE_ENV=production.
DEV_AUTH=true

# S3-compatible storage (RustFS locally, Cloudflare R2 in prod) — two buckets, docs/01-architecture.md §6
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_PUBLIC_BUCKET=media-public
S3_PRIVATE_BUCKET=media-private
S3_FORCE_PATH_STYLE=true
# Public base URL of the public bucket (R2 custom domain in prod; RustFS anonymous read locally)
CDN_BASE_URL=http://localhost:9000/media-public
# Testing on a real phone: the phone cannot reach "localhost". Run `pnpm dev:lan` (sets both to the
# computer's LAN IP), or set them by hand, e.g. CDN_BASE_URL=http://192.168.1.20:9000/media-public
# and S3_PUBLIC_ENDPOINT=http://192.168.1.20:9000 (host used in presigned URLs; defaults to S3_ENDPOINT).
# S3_PUBLIC_ENDPOINT=

# Comma-separated origins allowed by CORS (admin-web)
CORS_ORIGINS=http://localhost:3000
